# ============================================================
# Chiangrai Booking — Root Environment
# ============================================================
#
# This file documents every variable consumed by the monorepo.
# Copy to `.env.local` and fill in real values.
#
# IMPORTANT:
#   - Backend reads from apps/backend/.env.local
#   - Frontend reads from apps/frontend/.env.local
#   - This root file is convenient for local-dev only
#
# MOCK MODE:
#   If you leave Supabase / Stripe / email keys blank, the app boots
#   in "mock mode" — every external call returns plausible fake data.
#   Useful for getting started without real accounts. Production must
#   set every variable below.
# ============================================================

# ----- App URLs -----
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE=http://localhost:3001
BACKEND_URL=http://localhost:3001

# ----- Auth -----
# JWT_SECRET must be at least 32 characters in production.
# In mock mode (no Supabase) a dev fallback is used.
JWT_SECRET=
# NextAuth secret — must match JWT_SECRET in this project
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ----- Supabase -----
# Leave blank to enable mock mode.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ----- Stripe -----
# Leave blank or use sk_test_mock... to enable mock Stripe wrapper.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ----- Email (Resend OR Brevo — leave both blank for mock) -----
RESEND_API_KEY=
BREVO_API_KEY=
EMAIL_FROM_NAME=Chiangrai Booking
EMAIL_FROM_ADDRESS=noreply@example.com

# ----- Logging -----
# debug | info | warn | error | fatal
LOG_LEVEL=

# ----- Rate limiting (optional, production) -----
# Set these to enable Vercel KV-backed rate limiting in production.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ----- Referral program (optional — defaults shown) -----
# Auto-issued coupons when a referee makes their first paid booking.
# Both sides get the same coupon shape. Tunable without redeploying.
# Already-issued coupons are NOT retroactively updated.
REFERRAL_REWARD_PERCENT=10
REFERRAL_REWARD_MAX_THB=500
REFERRAL_REWARD_DAYS=90

# ----- Loyalty program (optional — defaults shown) -----
# THB per 1 earned point at award time. Default 100 → ฿1500
# booking earns 15 points. Lower = more generous. Backend-only
# env; the frontend "+N pts" previews use a shared constant.
LOYALTY_RATE_THB_PER_POINT=100
