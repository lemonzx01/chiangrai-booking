# ============================================================
# Backend Environment (apps/backend)
# ============================================================
# Copy to apps/backend/.env.local and fill in for local dev,
# or set in Vercel project settings for production.
# ============================================================

# ----- Server -----
NODE_ENV=development
PORT=3001

# ----- Auth -----
# Required in production; mock mode uses a dev fallback.
JWT_SECRET=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# ----- Frontend URL (used for redirects, emails, etc.) -----
NEXT_PUBLIC_FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ----- Supabase (leave blank for mock mode) -----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ----- Stripe (leave blank for mock mode) -----
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ----- Email (Resend preferred, Brevo fallback) -----
RESEND_API_KEY=
BREVO_API_KEY=
EMAIL_FROM_NAME=Chiangrai Booking
EMAIL_FROM_ADDRESS=noreply@example.com

# ----- Google OAuth (optional) -----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ----- Logging -----
LOG_LEVEL=

# ----- Rate limiting (production, optional) -----
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ----- Referral program (optional — defaults shown) -----
# Tunes the auto-issued coupons when a referee makes their first
# paid booking. Both sides earn the same coupon shape.
# Changes don't retroactively update already-issued coupons.
REFERRAL_REWARD_PERCENT=10
REFERRAL_REWARD_MAX_THB=500
REFERRAL_REWARD_DAYS=90

# ----- Loyalty program (optional — defaults shown) -----
# THB per 1 earned point. Lower = more generous. Default 100
# means a ฿1500 booking earns 15 points. Frontend "+N pts"
# previews on detail pages use the shared default constant
# (LOYALTY_DEFAULT_RATE_THB_PER_POINT in @chiangrai/shared);
# this env only overrides the BACKEND award path.
LOYALTY_RATE_THB_PER_POINT=100
