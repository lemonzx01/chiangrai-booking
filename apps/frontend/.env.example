# ============================================================
# Frontend Environment (apps/frontend)
# ============================================================
# Copy to apps/frontend/.env.local and fill in for local dev,
# or set in Vercel project settings for production.
# ============================================================

# ----- App URLs -----
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_FRONTEND_URL=http://localhost:3000

# ----- Backend URL (rewrite target for /api/*) -----
# In dev:    http://localhost:3001
# In prod:   https://your-backend.vercel.app
BACKEND_URL=http://localhost:3001
NEXT_PUBLIC_API_BASE=http://localhost:3001

# ----- Auth -----
# Must match the backend's JWT_SECRET in production.
JWT_SECRET=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# ----- Supabase (only NEXT_PUBLIC_* keys used on the frontend) -----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ----- Stripe publishable key -----
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ----- Google OAuth (optional) -----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
