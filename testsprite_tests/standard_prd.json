{
  "meta": {
    "project": "Got Journey Thailand Travel Booking Platform",
    "date": "2026-01-21",
    "prepared_by": "Got Journey Thailand Development Team"
  },
  "product_overview": "Got Journey Thailand is a comprehensive travel booking platform designed to facilitate seamless hotel and car rental bookings in Chiang Rai, Thailand. Featuring a multi-vendor marketplace, integrated payment processing through Stripe, secure authentication including Google OAuth, and robust admin and partner dashboards, it aims to provide an easy and secure travel booking experience with multilingual support and advanced booking management.",
  "core_goals": [
    "Enable users to easily browse and book hotels and rental cars with detailed information and secure payments.",
    "Provide a multi-vendor platform allowing hotel and car rental partners to manage their listings and earnings.",
    "Offer comprehensive administrative capabilities for managing hotels, cars, bookings, partners, and payments to ensure smooth operations.",
    "Implement secure, scalable authentication and authorization flows supporting email/password and Google OAuth login.",
    "Support multiple payment methods and currencies with real-time booking and payment status updates.",
    "Ensure a responsive, user-friendly interface with multilingual support and mobile responsiveness."
  ],
  "key_features": [
    "Hotel browsing and detailed hotel and room type views with filtering and pagination.",
    "Car rental browsing and detailed views with filters for brand, model, and pricing.",
    "User registration, login (email/password and Google OAuth), session management, and password reset.",
    "Booking creation for hotels and cars with validation, price calculation, and unique booking code generation.",
    "Stripe-based payment processing supporting credit cards, PayPal, PromptPay, and multi-currency checkout sessions.",
    "Admin dashboard for CRUD operations on hotels, cars, bookings, partners, and payment statistics.",
    "Partner dashboard with Stripe Connect integration for payout and earnings management.",
    "Email notification system via Resend for booking confirmations and password resets.",
    "Comprehensive API with OpenAPI specification for all public and authenticated endpoints.",
    "Strict security including JWT authentication, bcrypt password hashing, CSRF protection, input validation, and webhook signature verification."
  ],
  "user_flow_summary": [
    "Guests browse hotels or cars on listing pages with optional filters and pagination.",
    "Users view detailed information pages for selected hotels or cars including availability and pricing.",
    "Registered users create bookings by selecting dates, room or car types, and entering guest or driver information.",
    "Users proceed to payment via Stripe Checkout session and are redirected to payment provider.",
    "Upon payment success, system updates booking status and sends confirmation emails.",
    "Users can view their bookings and download invoices using unique booking codes.",
    "Admins authenticate via dedicated login and access dashboard to manage all aspects of the platform including hotels, cars, bookings, partners, and payments.",
    "Partners log in to manage their properties, bookings, and Stripe payout integration.",
    "Password reset and session management flows allow users to securely maintain their accounts."
  ],
  "validation_criteria": [
    "API endpoints respond within 2 seconds for 95% of requests and database queries under 500ms.",
    "Bookings validate date ranges (check-in before check-out, future dates) and positive guest counts.",
    "User registration enforces unique email and password minimum length of 8 characters.",
    "Authentication securely returns and consumes JWT tokens with HttpOnly cookies, differentiating user and admin roles.",
    "Stripe payment sessions are created and webhook events processed correctly updating booking statuses.",
    "Admin-only endpoints enforce proper authorization and validation of CRUD operations.",
    "All input schemas validated using Zod ensuring data integrity.",
    "Error responses provide meaningful messages in Thai and English with standardized error codes.",
    "UI supports Thai and English with correct i18n content, date and currency formats.",
    "Security measures including password hashing, CSRF, and rate limiting are implemented and verified.",
    "System scales to support over 1000 concurrent users and 10,000+ bookings per day under load testing scenarios."
  ],
  "code_summary": {
