{
  "tech_stack": [
    "TypeScript",
    "Next.js 14",
    "Next.js App Router",
    "Supabase",
    "PostgreSQL",
    "Stripe",
    "NextAuth.js v5",
    "JWT (jose)",
    "bcryptjs",
    "React",
    "Tailwind CSS"
  ],
  "features": [
    {
      "name": "List Hotels",
      "description": "Get paginated list of hotels with filtering and search capabilities",
      "files": [
        "apps/backend/src/app/api/hotels/route.ts"
      ],
      "api_doc": {
        "openapi": "3.0.0",
        "info": {
          "title": "List Hotels API",
          "version": "1.0.0"
        },
        "paths": {
          "/api/hotels": {
            "get": {
              "summary": "List hotels",
              "description": "Get paginated list of hotels with optional filtering",
              "parameters": [
                {
                  "name": "limit",
                  "in": "query",
                  "schema": {
                    "type": "integer",
                    "default": 10
                  }
                },
                {
                  "name": "offset",
                  "in": "query",
                  "schema": {
                    "type": "integer",
                    "default": 0
                  }
                },
                {
                  "name": "location",
                  "in": "query",
                  "schema": {
                    "type": "string"
                  }
                }
              ],
              "responses": {
                "200": {
                  "description": "Success",
                  "content": {
                    "application/json": {
                      "schema": {
                        "type": "object",
                        "properties": {
                          "data": {
                            "type": "array",
                            "items": {
                              "$ref": "#/components/schemas/Hotel"
                            }
                          },
                          "pagination": {
                            "type": "object",
                            "properties": {
                              "limit": {
                                "type": "integer"
                              },
                              "offset": {
                                "type": "integer"
                              },
                              "total": {
                                "type": "integer"
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "name": "Get Hotel Details",
      "description": "Get detailed information about a specific hotel including room types",
      "files": [
        "apps/backend/src/app/api/hotels/[id]/route.ts"
      ],
      "api_doc": {
        "openapi": "3.0.0",
        "paths": {
          "/api/hotels/{id}": {
            "get": {
              "summary": "Get hotel details",
              "parameters": [
                {
                  "name": "id",
                  "in": "path",
                  "required": true,
                  "schema": {
                    "type": "string"
                  }
                }
              ],
              "responses": {
                "200": {
                  "description": "Success",
                  "content": {
                    "application/json": {
                      "schema": {
                        "type": "object",
                        "properties": {
                          "hotel": {
                            "$ref": "#/components/schemas/Hotel"
                          },
                          "room_types": {
                            "type": "array",
                            "items": {
                              "$ref": "#/components/schemas/RoomType"
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "name": "User Login",
      "description": "Authenticate user or admin with email and password, returns JWT token in cookie",
      "files": [
        "apps/backend/src/app/api/auth/login/route.ts"
      ],
      "api_doc": {
        "openapi": "3.0.0",
        "paths": {
          "/api/auth/login": {
            "post": {
              "summary": "User/Admin login",
              "requestBody": {
                "required": true,
                "content": {
                  "application/json": {
                    "schema": {
                      "type": "object",
                      "required": ["email", "password"],
                      "properties": {
                        "email": {
                          "type": "string",
                          "format": "email"
                        },
                        "password": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              },
              "responses": {
                "200": {
                  "description": "Login successful",
                  "headers": {
                    "Set-Cookie": {
                      "schema": {
                        "type": "string"
                      }
                    }
                  },
                  "content": {
                    "application/json": {
                      "schema": {
                        "type": "object",
                        "properties": {
                          "user": {
                            "type": "object",
                            "properties": {
                              "id": {
                                "type": "string"
                              },
                              "email": {
                                "type": "string"
                              },
                              "name": {
                                "type": "string"
                              },
                              "role": {
                                "type": "string",
                                "enum": ["user", "admin", "partner"]
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                },
                "401": {
                  "description": "Invalid credentials"
                }
              }
            }
          }
        }
      }
    },
    {
      "name": "Admin Login",
      "description": "Authenticate admin user with email and password",
      "files": [
        "apps/backend/src/app/api/admin/login/route.ts"
      ],
      "api_doc": {
        "openapi": "3.0.0",
        "paths": {
          "/api/admin/login": {
            "post": {
              "summary": "Admin login",
              "requestBody": {
                "required": true,
                "content": {
                  "application/json": {
                    "schema": {
                      "type": "object",
                      "required": ["email", "password"],
                      "properties": {
                        "email": {
                          "type": "string"
                        },
                        "password": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              },
              "responses": {
                "200": {
                  "description": "Login successful"
                },
                "401": {
                  "description": "Invalid credentials"
                }
              }
            }
          }
        }
      }
    },
    {
      "name": "User Registration",
      "description": "Register a new user account with email and password",
      "files": [
        "apps/backend/src/app/api/auth/register/route.ts"
      ],
      "api_doc": {
        "openapi": "3.0.0",
        "paths": {
          "/api/auth/register": {
            "post": {
              "summary": "Register new user",
              "requestBody": {
                "required": true,
                "content": {
                  "application/json": {
                    "schema": {
                      "type": "object",
                      "required": ["email", "password", "name"],
                      "properties": {
                        "email": {
                          "type": "string",
                          "format": "email"
                        },
                        "password": {
                          "type": "string",
                          "minLength": 6
                        },
                        "name": {
                          "type": "string"
                        },
                        "phone": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              },
              "responses": {
                "201": {
                  "description": "User created successfully"
                },
                "409": {
                  "description": "Email already exists"
                },
                "400": {
                  "description": "Invalid input"
                }
              }
            }
          }
        }
      }
    },
    {
      "name": "Google OAuth",
      "description": "Initiate Google OAuth authentication flow",
      "files": [
        "apps/backend/src/app/api/auth/[...nextauth]/route.ts",
        "apps/backend/src/lib/auth/nextauth.ts"
      ],
      "api_doc": {
        "openapi": "3.0.0",
        "paths": {
          "/api/auth/signin/google": {
            "get": {
              "summary": "Initiate Google OAuth",
              "parameters": [
                {
                  "name": "csrfToken",
                  "in": "query",
                  "schema": {
                    "type": "string"
                  }
                },
                {
                  "name": "callbackUrl",
                  "in": "query",
                  "schema": {
                    "type": "string"
                  }
                }
              ],
              "responses": {
                "302": {
                  "description": "Redirect to Google OAuth"
                },
                "500": {
                  "description": "Google OAuth not configured"
                }
              }
            }
          },
          "/api/auth/csrf": {
            "get": {
              "summary": "Get CSRF token",
              "responses": {
                "200": {
                  "description": "CSRF token",
                  "content": {
                    "application/json": {
                      "schema": {
                        "type": "object",
                        "properties": {
                          "csrfToken": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "name": "Create Booking",
      "description": "Create a new hotel or car booking",
      "files": [
        "apps/backend/src/app/api/bookings/route.ts"
      ],
      "api_doc": {
        "openapi": "3.0.0",
        "paths": {
          "/api/bookings": {
            "post": {
              "summary": "Create booking",
              "security": [
                {
                  "cookieAuth": []
                }
              ],
              "requestBody": {
                "required": true,
                "content": {
                  "application/json": {
                    "schema": {
                      "type": "object",
                      "required": ["type", "check_in", "check_out", "customer_name", "customer_email"],
                      "properties": {
                        "type": {
                          "type": "string",
                          "enum": ["hotel", "car"]
                        },
                        "hotel_id": {
                          "type": "string"
                        },
                        "car_id": {
                          "type": "string"
                        },
                        "room_type_id": {
                          "type": "string"
                        },
                        "check_in": {
                          "type": "string",
                          "format": "date"
                        },
                        "check_out": {
                          "type": "string",
                          "format": "date"
                        },
                        "customer_name": {
                          "type": "string"
                        },
                        "customer_email": {
                          "type": "string"
                        },
                        "customer_phone": {
                          "type": "string"
                        },
                        "guests": {
                          "type": "integer"
                        }
                      }
                    }
                  }
                }
              },
              "responses": {
                "201": {
                  "description": "Booking created"
                },
                "400": {
                  "description": "Invalid input"
                },
                "404": {
                  "description": "Hotel/Car not found"
                }
              }
            }
          }
        }
      }
    },
    {
      "name": "Get Booking Details",
      "description": "Get booking details by booking code",
      "files": [
        "apps/backend/src/app/api/bookings/[code]/route.ts"
      ],
      "api_doc": {
        "openapi": "3.0.0",
        "paths": {
          "/api/bookings/{code}": {
            "get": {
              "summary": "Get booking by code",
              "parameters": [
                {
                  "name": "code",
                  "in": "path",
                  "required": true,
                  "schema": {
                    "type": "string"
                  }
                }
              ],
              "responses": {
                "200": {
                  "description": "Booking found"
                },
                "404": {
                  "description": "Booking not found"
                }
              }
            }
          }
        }
      }
    },
    {
      "name": "Create Checkout Session",
      "description": "Create Stripe checkout session for payment",
      "files": [
        "apps/backend/src/app/api/checkout/route.ts"
      ],
      "api_doc": {
        "openapi": "3.0.0",
        "paths": {
          "/api/checkout": {
            "post": {
              "summary": "Create checkout session",
              "security": [
                {
                  "cookieAuth": []
                }
              ],
              "requestBody": {
                "required": true,
                "content": {
                  "application/json": {
                    "schema": {
                      "type": "object",
                      "required": ["booking_id"],
                      "properties": {
                        "booking_id": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              },
              "responses": {
                "200": {
                  "description": "Checkout session created",
                  "content": {
                    "application/json": {
                      "schema": {
                        "type": "object",
                        "properties": {
                          "url": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "name": "List Cars",
      "description": "Get list of available rental cars",
      "files": [
        "apps/backend/src/app/api/cars/route.ts"
      ],
      "api_doc": {
        "openapi": "3.0.0",
        "paths": {
          "/api/cars": {
            "get": {
              "summary": "List cars",
              "responses": {
                "200": {
                  "description": "List of cars"
                }
              }
            }
          }
        }
      }
    },
    {
      "name": "Get Car Details",
      "description": "Get detailed information about a specific car",
      "files": [
        "apps/backend/src/app/api/cars/[id]/route.ts"
      ],
      "api_doc": {
        "openapi": "3.0.0",
        "paths": {
          "/api/cars/{id}": {
            "get": {
              "summary": "Get car details",
              "parameters": [
                {
                  "name": "id",
                  "in": "path",
                  "required": true,
                  "schema": {
                    "type": "string"
                  }
                }
              ],
              "responses": {
                "200": {
                  "description": "Car found"
                },
                "404": {
                  "description": "Car not found"
                }
              }
            }
          }
        }
      }
    }
  ]
}
